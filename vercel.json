{
  "buildCommand": "node build.js",
  "outputDirectory": "public",
  "framework": null,
  "rewrites": [
    { "source": "/docs/:slug", "destination": "/docs/:slug.html" },
    { "source": "/docs", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    }
  ]
}
